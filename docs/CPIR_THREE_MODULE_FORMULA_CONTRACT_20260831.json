      "role": "candidate-conditioned native physical forward response under do(S=s)",
      "equation": "C_{1:N}^{s,k}=F_GADEN(do(S=s),K=k,X_{1:N},E)",
      "transport_member_semantics": "exchangeable_nuisance_sample_not_temporal_state",
