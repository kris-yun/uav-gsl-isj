        "true_or_best_transport_member_selection",
        "observation_world_hidden_member_id",
        "posterior_or_rank_training_target",
        "localization_error_tuning"
      ]
    },
    "M2": {
      "name": "Persistent Sensor-State Transduction",
      "role": "candidate physical tape to carried sensor state to stop detection",
      "dt_s": 0.2,
      "tau_s": 1.2,
      "alpha": 0.846481724890614,
      "delay_samples": 2,
      "dead_time_s": 0.4,
      "threshold_ppm": 0.1,
      "stop_samples": 80,
      "stop_duration_s": 16.0,
      "state_equation": "R_n^{s,k}=alpha R_{n-1}^{s,k}+(1-alpha)C_{n-2}^{s,k}",
      "candidate_event": "Z_{sbk}=1[max_{n in I_b} R_n^{s,k}>theta]",
      "observed_event": "Y_b=1[max_{n in I_b} M_n^obs>theta]",
      "state_reset_policy": "never_reset_at_motion_stop_or_source_update",
      "observation_policy": "real_measured_tape_is_not_filtered_again"
    },
    "M3": {
      "name": "Stop-Resolved Reachability Detection Composite Likelihood",
      "role": "retain physical-stop identity in repeated detection/non-detection evidence",
      "predictive_hit_count": "h_{sb}=sum_k Z_{sbk}",
      "prior": "Beta(1/2,1/2)",
      "predictive_probability": "q_{sb}=(h_{sb}+1/2)/(M+1)",
      "full_score": "ell_M3(s)=sum_b[Y_b log q_{sb}+(1-Y_b)log(1-q_{sb})]",
      "count_only_comparator": "ell_count(s)=H_plus log qbar_s+(B-H_plus)log(1-qbar_s), qbar_s=mean_b q_{sb}",
      "joint_claim": "composite_likelihood_not_exact_joint_transport_probability",
      "first_passage_phase": "forbidden_from_primary_score"
    }
  },
  "carrier_to_cell_interface": {
    "counted_as_module": false,
    "name": "KL information projection",
    "constraint": "sum_{c in C_i} Q_cell(c)=Q_carrier(i)",
    "solution": "Q_cell(c)=Q_carrier(i(c))*p_ref(c)/sum_{u in C_i(c)}p_ref(u)",
