#pragma once
#include <deque>
#include <vector>
#include <algorithm>
#include <cmath>
namespace GSL { namespace CP {
struct StoppingConfig {
    float alpha; int min_cal; int max_win; float w_thresh; int stable_req;
    StoppingConfig():alpha(0.10f),min_cal(8),max_win(50),w_thresh(1.5f),stable_req(3){}
};
class OnlineConformalStopping {
public:
    explicit OnlineConformalStopping(const StoppingConfig& c=StoppingConfig()):cfg_(c){}
    void addObs(float r){s_.push_back(r);if((int)s_.size()>cfg_.max_win)s_.pop_front();}
    float getWidth()const{int n=s_.size();if(n<cfg_.min_cal)return 1e6f;std::vector<float>v(s_.begin(),s_.end());std::sort(v.begin(),v.end());int q=std::clamp((int)std::ceil((n+1)*(1-cfg_.alpha))-1,0,n-1);return v[q];}
    bool shouldStop(){float w=getWidth();if(w<cfg_.w_thresh)st_++;else st_=0;return st_>=cfg_.stable_req;}
    void reset(){s_.clear();st_=0;}int size()const{return s_.size();}
private:StoppingConfig cfg_;std::deque<float>s_;int st_=0;
};
class SourceConfidenceRegion {
public:
    struct Config{
        float alpha;int min_p;int max_h;
        Config():alpha(0.10f),min_p(6),max_h(40){}
    };
    explicit SourceConfidenceRegion(const Config&c=Config()):c_(c){}
    void addMAP(float x,float y,float z){hx_.push_back(x);hy_.push_back(y);hz_.push_back(z);if((int)hx_.size()>c_.max_h){hx_.pop_front();hy_.pop_front();hz_.pop_front();}}
    float getRadius()const{int n=hx_.size();if(n<c_.min_p)return 1e6f;std::vector<float>sx(hx_.begin(),hx_.end()),sy(hy_.begin(),hy_.end());std::sort(sx.begin(),sx.end());std::sort(sy.begin(),sy.end());float mx=sx[n/2],my=sy[n/2];std::vector<float>d;for(int i=0;i<n;i++)d.push_back(std::sqrt((hx_[i]-mx)*(hx_[i]-mx)+(hy_[i]-my)*(hy_[i]-my)));std::sort(d.begin(),d.end());int q=std::clamp((int)std::ceil((n+1)*(1-c_.alpha))-1,0,n-1);return d[q];}
    bool stable(float t=1.0f)const{return getRadius()<t;}
    void centroid(float&x,float&y,float&z)const{x=y=z=0;int n=hx_.size();if(!n)return;for(int i=0;i<n;i++){x+=hx_[i];y+=hy_[i];z+=hz_[i];}x/=n;y/=n;z/=n;}
    void reset(){hx_.clear();hy_.clear();hz_.clear();}
private:Config c_;std::deque<float>hx_,hy_,hz_;
};
}} // namespace GSL::CP
