    int convergence_min_bouts_ = 2, convergence_stable_steps_ = 5, stable_steps_count_ = 0;
    bool convergence_reported_ = false;

    // Wind history
    std::vector<float> obs_history_x_, obs_history_y_, obs_history_c_;
