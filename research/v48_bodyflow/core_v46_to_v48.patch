+def refine_catalog(catalog, scales=(1.0,)):
+    """Common, source-blind speed refinement with unchanged action duration.
+
+    Every refinement is subsequently checked by the SAME continuous safety
+    predicate.  No collision clearance is relaxed.  The zero action is not
+    repeated; positive-scale semantic IDs are stable under storage permutation.
+    Candidate count/safety cost must be logged separately from expensive K.
+    """
+    if (not scales or scales[0] != 1.0 or not np.all(np.isfinite(scales))
+            or any(not 0 < x <= 1 for x in scales)
+            or any(b >= a for a,b in zip(scales,scales[1:]))):
+        raise ValueError("Invalid common scales")
+    out=list(catalog)
+    if len({a.semantic_id for a in out}) != len(out):
+        raise ValueError("Duplicate base candidate IDs")
+    for level,scale in enumerate(scales[1:],start=1):
+        for a in catalog:
+            if np.linalg.norm(a.velocities) <= 1e-12:
+                continue
+            out.append(Candidate(a.semantic_id+f"_S{level:02d}", a.sensor_ids,
+                         scale*a.velocities, a.duration, scale*a.common_scale))
     return out
 
 
