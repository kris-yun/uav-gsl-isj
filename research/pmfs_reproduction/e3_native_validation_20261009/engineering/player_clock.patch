+void Player::advancePhysicalClock(const char* reason)
+{
+    if (r7Times.empty()) return;
+    const int64_t stamp=now().nanoseconds();
+    if (stamp <= 0) return;
+    if (r7AnchorROS < 0) r7AnchorROS=stamp;
+    if (stamp < r7AnchorROS) throw std::runtime_error("ROS clock moved backwards");
+    const double target=r7BasePhysical + double(stamp-r7AnchorROS)/1e9;
+    bool changed=false;
+    while (r7Frame+1 < r7Times.size() && r7Times.at(r7Frame+1) <= target)
+    {
+        Scene->AdvanceTimestep(); ++r7Frame; changed=true;
+    }
+    if (target > r7Times.back()) throw std::runtime_error("Physical replay exhausted qualified recording");
+    if (changed || std::string(reason)!="loop")
+    {
+        r7Trace << stamp << "," << r7AnchorROS << "," << target << "," << r7Frame << ","
+                << r7Times.at(r7Frame) << "," << r7Times.at(std::min(r7Frame+1,r7Times.size()-1)) << ","
+                << environmentConfig->windSequence.GetCurrentIndex() << "," << reason << "\n";
+        r7Trace.flush();
+    }
+}
