        self.declare_parameter('sensor_initial_input_ppm', 0.0)
        self.declare_parameter('gaden_iteration_mode', 'seeded_time_replay')
        self.declare_parameter('sensor_trace_file', '')
        self.declare_parameter('wind_trace_file', '')
