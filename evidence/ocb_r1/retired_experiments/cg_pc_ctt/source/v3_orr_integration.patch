+#!/usr/bin/env bash
+set -Eeo pipefail
+
+# Truth-blind one-arm adapter used under run_case_after_online_build.sh.
+: "${HOUSE:?}" "${SEED:?}" "${ARM:?}" "${CASE_OUTPUT_DIR:?}" "${DOMAIN_ID:?}"
+TIMEOUT_SEC="${TIMEOUT_SEC:-300}"
+STEPS_SOURCE_UPDATE="${STEPS_SOURCE_UPDATE:-3}"
+PFDI_ROOT="${PFDI_ROOT:-/dev/shm/cg_pc_ctt_v3_orr_20260827}"
+REPO_ROOT="${REPO_ROOT:-/home/zyc/uav-gsl-isj}"
+INNER="${REPO_ROOT}/reference/run_meaci_case_20260824.sh"
+BINARY="${PFDI_ROOT}/install/gsl_server/lib/gsl_server/gsl_actionserver_node"
+
+test -f "${INNER}"
+test -x "${BINARY}"
+mkdir -p "${CASE_OUTPUT_DIR}"
+case "${ARM}" in
+  off) MODE=off ;;
+  on) MODE=v3_orr ;;
+  *) echo "unsupported ARM=${ARM}" >&2; exit 2 ;;
+esac
+
+RUNTIME_ROOT="${CASE_OUTPUT_DIR}/runtime"
+RUN_DIR="${RUNTIME_ROOT}/${HOUSE}_seed${SEED}_${ARM}_${MODE}"
+RUN_ID="V3_ORR_${HOUSE}_S${SEED}_${ARM}_${MODE}"
+
+HOUSE="${HOUSE}" SEED="${SEED}" ARM="${ARM}" RUN_ROOT="${RUNTIME_ROOT}" \
+PFDI_MODE="${MODE}" RUN_ID="${RUN_ID}" DOMAIN_ID="${DOMAIN_ID}" \
+TADM_REPLICAS=4 PFDI_INSTALL_ROOT="${PFDI_ROOT}" \
+TIMEOUT_SEC="${TIMEOUT_SEC}" OUTER_DEADLINE_SEC="${OUTER_DEADLINE_SEC:-600}" \
+STEPS_SOURCE_UPDATE="${STEPS_SOURCE_UPDATE}" TARGET_SOURCE_UPDATES=0 TARGET_ACCEPTED_UPDATES=0 \
+EVALUATOR_SCRIPT=/nonexistent/v3_truth_is_external_only.py \
+bash "${INNER}"
+
+test -s "${RUN_DIR}/run_status.json"
+LATEST_POSTERIOR="$(find "${RUN_DIR}/context_bank" -mindepth 2 -maxdepth 2 -type f -name source_posterior.csv | sort | tail -n 1)"
+test -n "${LATEST_POSTERIOR}"
+cp -a "${LATEST_POSTERIOR}" "${CASE_OUTPUT_DIR}/final_posterior.csv"
+sha256sum "${BINARY}" | awk '{print $1}' > "${CASE_OUTPUT_DIR}/online_binary.sha256"
+cp -a "${RUN_DIR}/run_status.json" "${CASE_OUTPUT_DIR}/run_status.json"
+
+if [[ "${MODE}" == v3_orr ]]; then
+  python3 "${REPO_ROOT}/closed_loop/cg_pc_ctt/verify_v3_orr_runtime_artifacts.py" \
+    --run-dir "${RUN_DIR}" --final-posterior "${CASE_OUTPUT_DIR}/final_posterior.csv" \
+    --out "${CASE_OUTPUT_DIR}/v3_orr_runtime_verdict.json"
+  awk -F, 'NR>1 && $14==1 {print $3; exit}' "${RUN_DIR}/tadm/v3_orr_update_audit.csv" \
+    > "${CASE_OUTPUT_DIR}/first_release_s.txt"
+fi
+
+echo "CG_PC_CTT_V3_ORR_ONE_ARM_COMPLETE HOUSE=${HOUSE} SEED=${SEED} ARM=${ARM} MODE=${MODE}"
