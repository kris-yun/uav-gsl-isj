@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Truth-blind infrastructure verifier for one V3-ORR online arm."""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+
+
+FORBIDDEN = {"truth", "source_x", "source_y", "truth_x", "truth_y", "localization_error"}
+
+
+def read_rows(path: Path):
+    with path.open(newline="", encoding="utf-8-sig") as handle:
+        reader = csv.DictReader(handle)
+        fields = list(reader.fieldnames or [])
+        rows = list(reader)
+    return fields, rows
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--final-posterior", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+
+    audit = args.run_dir / "tadm" / "v3_orr_update_audit.csv"
+    carriers = args.run_dir / "tadm" / "v3_orr_carrier_ids.csv"
+    if not audit.is_file() or not carriers.is_file():
+        raise SystemExit("missing V3-ORR audit/carrier artifact")
+    fields, rows = read_rows(audit)
+    if not rows:
+        raise SystemExit("empty V3-ORR audit")
+    lowered = {field.lower() for field in fields}
+    if lowered & FORBIDDEN:
+        raise SystemExit(f"truth leakage field in method audit: {sorted(lowered & FORBIDDEN)}")
+    released = 0
+    abstained = 0
+    for row in rows:
+        values = [float(row[key]) for key in (
+            "sim_time", "event_count", "carrier_count", "resolution_cells",
+            "resolved_edges", "unresolved_edges", "nuisance_rank", "source_probability_sum")]
+        if not all(math.isfinite(value) for value in values):
+            raise SystemExit("NaN/Inf in V3-ORR audit")
+        if abs(values[-1] - 1.0) > 1e-8:
+            raise SystemExit(f"posterior normalization failure: {values[-1]}")
+        flag = int(row["released"])
+        if flag not in (0, 1):
+            raise SystemExit(f"invalid released flag: {flag}")
+        released += flag
+        abstained += 1 - flag
+
+    _, carrier_rows = read_rows(carriers)
+    by_update = {}
+    for row in carrier_rows:
+        update = row["source_update_id"]
+        signature = (row["candidate_index"], row["candidate_id"], row["x"], row["y"], row["width"], row["height"])
+        by_update.setdefault(update, []).append(signature)
+    signatures = list(by_update.values())
+    if not signatures or any(signature != signatures[0] for signature in signatures[1:]):
+        raise SystemExit("persistent carrier identity drift")
+
+    posterior_fields, posterior_rows = read_rows(args.final_posterior)
+    required = {"x", "y", "source_probability"}
+    if not required.issubset(posterior_fields):
+        raise SystemExit("final posterior schema mismatch")
+    probabilities = [float(row["source_probability"]) for row in posterior_rows]
+    if not probabilities or any((not math.isfinite(value) or value < 0.0) for value in probabilities):
+        raise SystemExit("invalid final posterior values")
+    total = sum(probabilities)
+    if abs(total - 1.0) > 1e-6:
+        raise SystemExit(f"final posterior sum mismatch: {total}")
+
+    payload = {
+        "contract": "CG_PC_CTT_V3_ORR_RUNTIME_INFRASTRUCTURE_V1",
+        "verdict": "CG_PC_CTT_V3_ORR_RUNTIME_INFRASTRUCTURE_PASS",
+        "updates": len(rows),
+        "released_updates": released,
+        "abstained_updates": abstained,
+        "carrier_updates": len(signatures),
+        "carrier_count": len(signatures[0]),
+        "final_posterior_sum": total,
+        "truth_fields_in_method_audit": False,
+    }
+    args.out.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    print(json.dumps(payload, indent=2))
+
+
+if __name__ == "__main__":
+    main()
