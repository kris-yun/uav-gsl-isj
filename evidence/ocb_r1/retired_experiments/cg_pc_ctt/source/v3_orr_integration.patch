+#!/usr/bin/env bash
+set -Eeo pipefail
+
+# Isolated, serial ROS2 build for the frozen V3-ORR candidate.  The script
+# never writes to the existing /home/zyc/ros2_ws install.
+REPO_ROOT="${REPO_ROOT:-/home/zyc/uav-gsl-isj}"
+PFDI_ROOT="${PFDI_ROOT:-/dev/shm/cg_pc_ctt_v3_orr_20260827}"
+LEGACY_LAUNCH="${LEGACY_LAUNCH:-/home/zyc/meaci_v12_m_freeze_20260825/launch/vgr_gsl_pmfs_pfdi.launch.py}"
+SOURCE_ROOT="${REPO_ROOT}/ros2_package"
+
+test -f "${SOURCE_ROOT}/package.xml"
+test -f "${LEGACY_LAUNCH}"
+test ! -e "${PFDI_ROOT}"
+mkdir -p "${PFDI_ROOT}/build" "${PFDI_ROOT}/install" "${PFDI_ROOT}/log" \
+  "${PFDI_ROOT}/tmp" "${PFDI_ROOT}/colcon" "${PFDI_ROOT}/launch"
+cp -a "${LEGACY_LAUNCH}" "${PFDI_ROOT}/launch/vgr_gsl_pmfs_pfdi.launch.py"
+
+source /opt/ros/humble/setup.bash
+# The historical workspace setup has stale entries, but the two live message
+# overlays below are the authoritative dependency providers used by the last
+# isolated RCEC build.
+source /home/zyc/ros2_ws/install/setup.bash || true
+source /dev/shm/house1_msgs_install/setup.bash
+source /dev/shm/house2_gaden_install/setup.bash
+set -u
+
+export CMAKE_BUILD_PARALLEL_LEVEL=1
+export MAKEFLAGS=-j1
+export TMPDIR="${PFDI_ROOT}/tmp"
+export COLCON_HOME="${PFDI_ROOT}/colcon"
+
+git -C "${REPO_ROOT}" diff --check
+git -C "${REPO_ROOT}" rev-parse HEAD | tee "${PFDI_ROOT}/git_sha.txt"
+sha256sum \
+  "${SOURCE_ROOT}/src/gsl_server/algorithms/PMFS/PMFS.cpp" \
+  "${SOURCE_ROOT}/src/gsl_server/algorithms/PMFS/internal/Simulations.cpp" \
+  "${SOURCE_ROOT}/src/gsl_server/algorithms/PMFS/internal/ObservationResolvedV3.hpp" \
+  "${PFDI_ROOT}/launch/vgr_gsl_pmfs_pfdi.launch.py" \
+  | tee "${PFDI_ROOT}/prebuild_sha256.txt"
+
+cd /home/zyc
+colcon --log-base "${PFDI_ROOT}/log" build \
+  --base-paths "${SOURCE_ROOT}" \
+  --build-base "${PFDI_ROOT}/build" \
+  --install-base "${PFDI_ROOT}/install" \
+  --packages-select gsl_server \
+  --executor sequential \
+  --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE=-O2\ -g0
+
+BINARY="${PFDI_ROOT}/install/gsl_server/lib/gsl_server/gsl_actionserver_node"
+test -x "${BINARY}"
+sha256sum "${BINARY}" | tee "${PFDI_ROOT}/online_binary.sha256.full"
+sha256sum "${BINARY}" | awk '{print $1}' > "${PFDI_ROOT}/online_binary.sha256"
+sha256sum "${PFDI_ROOT}/launch/vgr_gsl_pmfs_pfdi.launch.py" | awk '{print $1}' > "${PFDI_ROOT}/launch.sha256"
+ldd "${BINARY}" > "${PFDI_ROOT}/binary.ldd.txt"
+echo CG_PC_CTT_V3_ORR_ISOLATED_BUILD=PASS
