<launch>
 <arg name="scenario" default="House03" />
 <arg name="simulation" default="5-3_fast" />

 <node pkg="gaden_preprocessing" exec="preprocessing" name="preprocessing" output="screen" >
     #Cell size
     <param name="cell_size" value="0.1"/>
     #CAD models of the enviroment (.stl)
     <param name="number_of_models" value="5"/>
     <param name="model_0" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03-main.stl"/>
     <param name="model_1" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet001.stl"/>
     <param name="model_2" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet002.stl"/>
     <param name="model_3" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet004.stl"/>
     <param name="model_4" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet006.stl"/>

        #CAD model of the outlets (.stl)
     <param name="number_of_outlet_models" value="2"/>
     <param name="outlets_model_0" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet003.stl"/>
     <param name="outlets_model_1" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/cad_models/House03Outlet005.stl"/>

        #3D Location of a point in free-space
     <param name="empty_point_x" value="0.0"/>
     <param name="empty_point_y" value="0.0"/>
     <param name="empty_point_z" value="1.0"/>

     <param name="floor_height" value="-0.64"/>
     <param name="worldFile" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/launch/ros/stage.world"/>

     #Wind Data (the node will append _i.csv to the name that is specified here)
     <param name="uniformWind" value="false"/>
     <param name="wind_files" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)/wind_simulations/$(var simulation)/$(var simulation)"/>

     #Where to write the output files
     <param name="output_path" value="$(find-pkg-share vgr_dataset)/scenarios/$(var scenario)" />
 </node>
</launch>