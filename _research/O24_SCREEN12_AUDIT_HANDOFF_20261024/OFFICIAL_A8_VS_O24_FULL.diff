+        {
+            x -= other.x;
+            y -= other.y;
+        }
+        inline Vector2 operator-()
+        {
+            return Vector2(-x, -y);
+        }
+
+        // other stuff
+        inline float dot(const Vector2& other) const
+        {
+            return x * other.x + y * other.y;
+        }
+
+        inline float norm() const
+        {
+            return std::sqrt(x * x + y * y);
+        }
+
+        inline Vector2 normalized() const
+        {
+            float n = norm();
+            if (n == 0)
+                return {0, 0};
+
+            return *this / n;
