+        {
+            Error();
+            printf("Ray starts inside an obstacle!\n");
+            return {false, 0};
+        }
+
+        direction = direction / direction.norm();
+        int stepX = sign(direction.x);
+        int stepY = sign(direction.y);
+        int stepZ = sign(direction.z);
